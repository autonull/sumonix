# org/extract.nix: the pages of the Pick-Your-AI repositories at pinned commits, as a list.
#
# Input: `trees` is a directory of `<name>.json`, the answer of `gh api repos/O/R/git/trees/SHA?recursive=1` for each line of
# org/PINS; `src` is a directory `<name>/` holding the Markdown, YAML, JSON and CODEOWNERS files of the same commit (`gh api
# repos/O/R/tarball/SHA | tar -xzf - --strip-components=1 --wildcards '*.md' ...`).  Both are scratch: org/pages.json is what this writes.
#
# Each page gets: its repository, path, git blob SHA and size (from the tree, so a reader can check them with `git hash-object`), the
# first heading of a Markdown file, the markers the page declares about itself ("<!-- plan-id", "Generated by", ...), and any
# former team name it still uses (docs/NAMING.md of the .github repository lists the renames).  Nothing here decides what a page
# is: that is org/classify.nix.
#
#   mlnix eval --json --expr 'import ./org/extract.nix { trees = "/abs/trees"; src = "/abs/src"; }'
{ trees, src }:
let
  inherit (builtins)
    readFile fromJSON filter map length elemAt head substring stringLength match split isString isList sort concatMap;

  lines = s: filter isString (split "\n" s);
  tabs = s: filter isString (split "\t" s);

  pins = map (l: let f = tabs l; in { name = elemAt f 0; sha = elemAt f 3; })
    (filter (l: l != "") (lines (readFile ./PINS)));

  baseName = p: let parts = filter isString (split "/" p); in elemAt parts (length parts - 1);
  isPage = p: match ".*\\.(md|json|ya?ml)" p != null || baseName p == "CODEOWNERS";
  isMd = p: match ".*\\.md" p != null;

  # The first "# heading" in the first 4000 characters of a Markdown file; null if there is none.
  titleOf = text:
    let
      hs = filter (l: match "#[ ]+(.*)" l != null) (lines (substring 0 4000 text));
      t = elemAt (match "#[ ]+(.*)" (head hs)) 0;
      clean = let m = match "(.*[^ \r])[ \r]*" t; in if m == null then t else head m;
    in if hs == [ ] then null else substring 0 120 clean;

  # Every distinct match of one pattern in a text: one pass, `split` gives the matched groups as lists.
  found = re: text:
    let
      ms = map head (filter isList (split re text));
      add = acc: m: if builtins.elem m acc then acc else acc ++ [ m ];
    in builtins.foldl' add [ ] ms;

  markRe = "(<!-- plan-id|Generated by|generated by|generated_at|generated from|auto-generated|do not edit|DO NOT EDIT)";
  formerRe = "(ai-tools-platforms|contributor-leaderboard-website|AI Tools & Platforms|AI Tools and Platforms|Mobile Devices|Research Lead Maintainers|Mobile Lead Maintainers)";

  page = pin: e:
    let text = readFile "${src}/${pin.name}/${e.path}";
    in {
      repo = pin.name;
      path = e.path;
      sha = e.sha;
      size = e.size;
      title = if isMd e.path then titleOf text else null;
      marks = found markRe text;
      former = found formerRe text;
    };

  pagesOf = pin:
    let tree = (fromJSON (readFile "${trees}/${pin.name}.json")).tree;
    in map (page pin) (filter (e: e.type == "blob" && isPage e.path) tree);
in
sort (a: b: a.repo < b.repo || (a.repo == b.repo && a.path < b.path)) (concatMap pagesOf pins)
