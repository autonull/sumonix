(step "s5" (dependsOnTransitive nginx openssl) "dependsOnTransitive#2" (bindings (?a nginx) (?b openssl)))
(step "s6" (vulnerable app CVE-2026-9999) "vulnerable#3" (bindings (?cve CVE-2026-9999) (?dep openssl) (?pkg app)))
(step "s7" (vulnerable curl CVE-2026-9999) "vulnerable#3" (bindings (?cve CVE-2026-9999) (?dep openssl) (?pkg curl)))
(step "s8" (vulnerable nginx CVE-2026-9999) "vulnerable#3" (bindings (?cve CVE-2026-9999) (?dep openssl) (?pkg nginx)))
(step "s9" (policyViolation nginx NoCriticalRunningCVE) "policyViolation#4" (bindings (?cve CVE-2026-9999) (?pkg nginx)))
(goal (policyViolation nginx NoCriticalRunningCVE) "s9")
