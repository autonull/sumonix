# Phase 4 — Proof export: emit a KIF certificate of a derivation.
#
#   toProof { ontology ? null ; facts ; rules ; goal
#           ; ontologies ? [ "sumo.full/Merge.kif" "nix-domain.kif" ] } -> string
#
# The certificate carries everything the independent checker (proof-check.nix)
# needs: the ontologies the engine was given, the rules verbatim with the same
# positional ids the engine assigned ("head#index"), the asserted facts, one
# step per derived fact (in round order, so a step's premises are the axioms and
# earlier steps), and the goal. NAF premises are checked against the full
# universe by the checker; positive and existential premises against the prefix.
#
# Nothing is shared with the checker beyond the parser (kif.nix).
{ ontology ? null, facts, rules, goal, ontologies ? [ "sumo.full/Merge.kif" "nix-domain.kif" ] }:
let
  kif = import ../kif.nix;
  engine = import ../datalog.nix { inherit ontology facts rules; };

  inherit (builtins) all any attrNames attrValues concatStringsSep elem elemAt filter foldl' head isList isString length map sort tail genList;

  flatten = f: if isList f then builtins.concatMap flatten f else [ f ];
  show = s:
    if isString s then
      if builtins.match ''.*[()" ].*'' s != null then ''"${s}"'' else s
    else "(" + concatStringsSep " " (map show s) + ")";

  headOf = f: if isList f && f != [ ] then head f else "";

  # The rules verbatim, with the engine's positional ids.
  ruleIds = genList (i: { id = "${headOf (elemAt (elemAt rules i) 2)}#${toString (i + 1)}"; rule = elemAt rules i; }) (length rules);

  entries = attrValues engine.trace;
  asserted = filter (e: e.by == null) entries;
  derived = filter (e: e.by != null) entries;
  ordered = sort
    (a: b:
      a.by.round < b.by.round
      || (a.by.round == b.by.round && show a.fact < show b.fact))
    derived;
  numbered = genList (i: { id = "s${toString (i + 1)}"; inherit (elemAt ordered i) fact by; }) (length ordered);

  goalShow = show goal;
  goalStep = filter (s: show s.fact == goalShow) numbered;

  bindingsText = b: concatStringsSep " "
    (map (v: "(" + v + " " + show b.${v} + ")") (attrNames b));

  lines =
    [ ";; proof certificate — generated by reasoner/proof.nix; do not edit" ]
    ++ map (o: "(ontology \"${o}\")") ontologies
    ++ map (r: "(rule \"${r.id}\" ${show r.rule})") ruleIds
    ++ map (e: "(fact ${show e.fact})") asserted
    ++ map (s: "(step \"${s.id}\" ${show s.fact} \"${s.by.rule}\" (bindings ${bindingsText s.by.bindings}))") numbered
    ++ (if goalStep != [ ] then [ "(goal ${goalShow} \"${(head goalStep).id}\")" ] else [ ]);
in
builtins.concatStringsSep "\n" lines + "\n"
