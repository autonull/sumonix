;; Curated machine facts for the host-native demo (scenario fixture).
;; source: fixture
;; Deterministic: the same 30 lines every run, so the policy verdict and the
;; proof are reproducible. Live facts are collected separately by
;; demo/host-facts.sh, which labels its output `source: live`.
;; kernel: runningKernel 6.6
;; services: nginx (running, NIXService, listensOn 80, runningAs nginx)
;; packages: nginx, openssl, curl, python3, redis, postgresql + closure mirrors
;; advisory: vulnerable openssl CVE-2026-9999 (severity critical) → policy verdict non-trivial

;; Kernel
(runningKernel "6.6")

;; NIXService: nginx
(instance nginx NIXPackage)
(instance nginx NIXService)
(serviceState nginx running)
(listensOn nginx 80)
(runningAs nginx nginx)

;; Installed packages (core set)
(instance openssl NIXPackage)
(instance curl NIXPackage)
(instance python3 NIXPackage)
(instance redis NIXPackage)
(instance postgresql NIXPackage)

;; Dependencies (closure mirrors of demo facts)
(dependsOn nginx openssl)
(dependsOn curl openssl)
(dependsOn python3 openssl)
(dependsOn redis openssl)
(dependsOn postgresql openssl)

;; Advisory
(vulnerable openssl CVE-2026-9999)
(severity CVE-2026-9999 critical)