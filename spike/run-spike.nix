# sumo-nix capability discovery spike — driver.
#
#   Local test (facts already generated):
#     nix eval --impure --raw --expr 'import ./spike/run-spike.nix { snapshot = builtins.readFile /tmp/opencode/facts.kif; }'
#   Inside the VM, /run/sumo-facts.kif is generated by the sumo-spike service before this eval.
{ snapshot ? builtins.readFile /run/sumo-facts.kif }:

let
  kif = import ../kif.nix;
  text = builtins.readFile;

  # SUMO + the NIX domain ontology (tests/scenario.nix pattern)
  ontology = import ../sumo.nix {
    forms = kif.parse (text ../sumo.full/Merge.kif) ++ kif.parse (text ../nix-domain.kif);
  };

  forms = kif.parse (snapshot + "\n" + text ./vuln-rules.kif + "\n" + text ./capabilities.kif);

  isRule = f: builtins.isList f && f != [ ] && builtins.head f == "=>";
  rules = builtins.filter isRule forms;
  facts = builtins.filter (f: !(isRule f)) forms;

  e = import ../datalog.nix { inherit ontology rules facts; };

  sortBy = field: builtins.sort (a: b: a.${field} < b.${field});

  directComps = sortBy "?pkg" (e.ask [ "canCompose" "?pkg" "?capA" "?capB" ]);
  enabledCaps = sortBy "?pkg" (e.ask [ "enablesCapability" "?pkg" "?cap" ]);
  synergyRaw = sortBy "?pkg" (e.ask [ "synergy" "?pkg" "?cap1" "?cap2" "?cap3" ]);

  # synergy derives every ordering of the triple; collapse to one row per (pkg, unordered caps)
  synergyKey = row:
    row."?pkg" + " " + builtins.concatStringsSep "+"
      (builtins.sort builtins.lessThan [ row."?cap1" row."?cap2" row."?cap3" ]);
  synergies = builtins.attrValues (builtins.listToAttrs (map (row: {
    name = synergyKey row;
    value = row // { caps = builtins.sort builtins.lessThan [ row."?cap1" row."?cap2" row."?cap3" ]; };
  }) synergyRaw));

  formatDirect = row: "  🔗 ${row."?pkg"} composes ${row."?capA"} + ${row."?capB"}";
  formatEnabled = row: "  ✨ ${row."?pkg"} enables ${row."?cap"} via dependency closure";
  formatSynergy = row:
    "  🚀 ${row."?pkg"} synergy: ${builtins.concatStringsSep " + " row.caps}";

  section = rows: lines:
    if rows == [ ] then "  (none derived)"
    else builtins.concatStringsSep "\n" (map lines rows);

  output = ''

    ╔═══════════════════════════════════════════════════════════════╗
    ║           SUMO-NIX CAPABILITY DISCOVERY SPIKE                 ║
    ║       "What novel capabilities can I compose?"                ║
    ╚═══════════════════════════════════════════════════════════════╝

    📦 DIRECT COMPOSITIONS (${toString (builtins.length directComps)}) — package + immediate deps:
    ${section directComps formatDirect}

    🌐 ENABLED CAPABILITIES (${toString (builtins.length enabledCaps)}) — via transitive dependency closure:
    ${section enabledCaps formatEnabled}

    💡 SYNERGIES (${toString (builtins.length synergies)}) — 3+ capabilities combining:
    ${section synergies formatSynergy}

    ─────────────────────────────────────────────────────────────
    ✨ Spike complete. Your nixpkgs is a capability goldmine.
  '';
in
output
