(fact (instance openssl NIXPackage))
(fact (serviceState nginx running))
(fact (severity CVE-2026-9999 critical))
(fact (vulnerable openssl CVE-2026-9999))
(step "s1" (dependsOnTransitive app curl) "dependsOnTransitive#2" (bindings (?a app) (?b curl)))
(step "s2" (dependsOnTransitive app openssl) "dependsOnTransitive#1" (bindings (?a app) (?b curl) (?c openssl)))
