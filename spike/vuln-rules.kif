;; SUMO-aligned capability composition rules.
;; Capability names are plain atoms; NIXPackage subclasses ComputerProgram (nix-domain.kif).
;; Transitive closures seed from the 1-hop base case, then extend by one edge.

;; dependsOn transitive closure
(=>
  (dependsOn ?a ?b)
  (dependsOnTransitive ?a ?b))

(=>
  (and (dependsOn ?a ?b) (dependsOnTransitive ?b ?c))
  (dependsOnTransitive ?a ?c))

;; Capability composition transitive closure
(=>
  (composesWith ?a ?b)
  (composesWithTransitive ?a ?b))

(=>
  (and (composesWith ?a ?b) (composesWithTransitive ?b ?c))
  (composesWithTransitive ?a ?c))

;; Direct composition: this package provides ?capA, an immediate dependency provides ?capB, ?capA composesWith ?capB
(=>
  (and
    (instance ?pkg NIXPackage)
    (providesCapability ?pkg ?capA)
    (composesWith ?capA ?capB)
    (providesCapability ?other ?capB)
    (dependsOn ?pkg ?other))
  (canCompose ?pkg ?capA ?capB))

;; Capabilities this package unlocks through its transitive dependencies
(=>
  (and
    (instance ?pkg NIXPackage)
    (providesCapability ?pkg ?cap)
    (composesWithTransitive ?cap ?otherCap)
    (providesCapability ?dep ?otherCap)
    (dependsOnTransitive ?pkg ?dep))
  (enablesCapability ?pkg ?otherCap))

;; Synergy: 3+ distinct enabled capabilities on the same package
(=>
  (and
    (enablesCapability ?pkg ?cap1)
    (enablesCapability ?pkg ?cap2)
    (enablesCapability ?pkg ?cap3)
    (not (equal ?cap1 ?cap2))
    (not (equal ?cap1 ?cap3))
    (not (equal ?cap2 ?cap3)))
  (synergy ?pkg ?cap1 ?cap2 ?cap3))
