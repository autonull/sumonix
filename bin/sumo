#!/usr/bin/env bash
# sumo — the command the user reaches for in the VM.
# Pure bash + nix eval (the two stores from tools/env.sh), on PATH in the VM.
# All evaluation flows through bin/_sumo.nix, a read-only dispatcher that returns the digest as an attrset.
# Local API sketch: s cmd [status], s topology, s proof [goal].

set -euo pipefail

# Source shared environment (NIX_STORE_DIR, NIX_STATE_DIR)
source "$(dirname "$0")/../tools/env.sh"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Default fact/rules/policies locations
SUMO_FACTS="${SUMO_FACTS:-/run/sumo/facts.kif}"
SUMO_RULES="${SUMO_RULES:-/run/sumo/rules.kif}"
SUMO_POLICIES="${SUMO_POLICIES:-${ROOT}/policies.kif}"

# If the default facts file doesn't exist, fall back to in-repo curated facts
if [ ! -f "$SUMO_FACTS" ]; then
  SUMO_FACTS="${ROOT}/demo/facts/host.kif"
fi

# If rules file doesn't exist or is empty/placeholder, fall back to root rules.kif
if [ ! -f "$SUMO_RULES" ] || [ ! -s "$SUMO_RULES" ]; then
  SUMO_RULES="${ROOT}/rules.kif"
fi

# If policies file doesn't exist, don't pass it (dispatcher will use default)
if [ ! -f "$SUMO_POLICIES" ] || [ ! -s "$SUMO_POLICIES" ]; then
  SUMO_POLICIES=""
fi

# Build the dispatcher with the current fact/rules/policies paths
DISPATCHER="${ROOT}/bin/_sumo.nix"

# Convert path to absolute
abs_path() {
  local p="$1"
  if [[ "$p" = /* ]]; then
    echo "$p"
  else
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  fi
}

# Build common dispatcher args
dispatcher_args() {
  local json_flag="${1:-false}"
  local facts_abs=$(abs_path "$SUMO_FACTS")
  local rules_abs=$(abs_path "$SUMO_RULES")
  local args="facts = \"${facts_abs}\"; rules = \"${rules_abs}\"; json = ${json_flag}"
  if [ -n "$SUMO_POLICIES" ]; then
    local policies_abs=$(abs_path "$SUMO_POLICIES")
    args="${args}; policies = \"${policies_abs}\""
  fi
  echo "(import ${DISPATCHER} { ${args}; })"
}

usage() {
  cat <<'EOF'
sumo — reason about this machine

Usage: sumo <command> [args...]

Commands:
  status [--json]         Machine overview: services, packages, capabilities, rounds; verdict + proof file
  caps [--json]           Capability atlas of the installed closure
  closure <pkg> [--json]  Dependency tree (indented)
  query <goal> [--json]   Ground goal → verdict + why subtree
  ask <pattern> [--json]  Non-ground query → all bindings (e.g., '(vulnerable ?pkg ?cve)')
  why <goal> [--json]     Proof tree for a ground goal
  proof <goal> [--json]   Export proof as KIF certificate (for 'sumo check')
  check <file.kif>        Independent re-checker for a proof certificate
  relax [--json]          Relaxation menu: which single fact/rule flip changes the verdict
  whatif [--json]         One counterfactual from the proof: two warm runs, exit 1 when a flip
  dashboard               Build and run the TUI over the digest (no TTY needed for --dump)
  refresh                 Re-collect live facts (sumo-facts on NixOS, demo/host-facts.sh elsewhere)
  guard [--json]          Policy check: exits 1 on violation, 0 when clean
  init [dir] [--force]    Scaffold a new sumonix project (facts/rules/policies + pre-commit + CI)
  lint [file...]          Lint KIF files for syntax errors
  version                 Show version
  --help                  Show this help

Environment:
  SUMO_FACTS    Path to facts KIF (default: /run/sumo/facts.kif, then demo/vm/host-facts.kif)
  SUMO_RULES    Path to rules KIF (default: /run/sumo/rules.kif, then rules.kif)
  SUMO_POLICIES Path to policies KIF (default: ./policies.kif, then none)

Examples:
  sumo status
  sumo status --json
  sumo caps
  sumo closure openssl
  sumo closure openssl --json
  sumo query '(vulnerable nginx CVE-2026-9999)'
  sumo ask '(vulnerable ?pkg ?cve)'
  sumo why '(policyViolation nginx NoCriticalRunningCVE)'
  sumo proof '(policyViolation nginx NoCriticalRunningCVE)' > proof.kif
  sumo check proof.kif
  sumo relax
  sumo whatif
  sumo dashboard
  sumo refresh
  sumo guard
  sumo guard --json
  sumo init my-project
  sumo init --force
  sumo lint facts.kif policies.kif
EOF
}

version() {
  echo "sumo 0.1.0 (sumonix)"
}

run_nix() {
  "$ROOT/nix-eval.sh" --raw --expr "$1"
}

# Parse subcommand
cmd="${1:-}"
shift || true

case "$cmd" in
  ""|--help|help)
    usage
    exit 0
    ;;
  version)
    version
    exit 0
    ;;
  status)
    json_flag=""
    if [ "${1:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).status"
    run_nix "$expr"
    ;;
  caps)
    json_flag=""
    if [ "${1:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).caps"
    run_nix "$expr"
    ;;
  closure)
    pkg="${1:-}"
    if [ -z "$pkg" ]; then
      echo "sumo closure: missing package argument" >&2
      exit 2
    fi
    json_flag=""
    if [ "${2:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).closure \"${pkg}\""
    run_nix "$expr"
    ;;
  query)
    goal="${1:-}"
    if [ -z "$goal" ]; then
      echo "sumo query: missing goal argument" >&2
      exit 2
    fi
    json_flag=""
    if [ "${2:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).query \"${goal}\""
    run_nix "$expr"
    ;;
  ask)
    pattern="${1:-}"
    if [ -z "$pattern" ]; then
      echo "sumo ask: missing pattern argument" >&2
      exit 2
    fi
    json_flag=""
    if [ "${2:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).ask \"${pattern}\""
    run_nix "$expr"
    ;;
  why)
    goal="${1:-}"
    if [ -z "$goal" ]; then
      echo "sumo why: missing goal argument" >&2
      exit 2
    fi
    json_flag=""
    if [ "${2:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).why \"${goal}\""
    run_nix "$expr"
    ;;
  proof)
    goal="${1:-}"
    if [ -z "$goal" ]; then
      echo "sumo proof: missing goal argument" >&2
      exit 2
    fi
    json_flag=""
    if [ "${2:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).proofExport \"${goal}\""
    run_nix "$expr"
    ;;
  check)
    cert_file="${1:-}"
    if [ -z "$cert_file" ]; then
      echo "sumo check: missing certificate file argument" >&2
      exit 2
    fi
    if [ ! -f "$cert_file" ]; then
      echo "sumo check: file not found: $cert_file" >&2
      exit 2
    fi
    # Convert to absolute path for the Nix evaluator
    cert_file="$(cd "$(dirname "$cert_file")" && pwd)/$(basename "$cert_file")"
    expr="(import ${DISPATCHER} { facts = \"${SUMO_FACTS}\"; rules = \"${SUMO_RULES}\"; }).check \"${cert_file}\""
    run_nix "$expr"
    ;;
  relax)
    json_flag=""
    if [ "${1:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).relax"
    run_nix "$expr"
    ;;
  whatif)
    json_flag=""
    if [ "${1:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).whatif"
    run_nix "$expr"
    ;;
  dashboard)
    # Resolve TUI binary: PATH → /run/sumo/bin/sumo-tui → repo demo/tui/sumo-tui
    TUI_BIN=""
    if command -v sumo-tui >/dev/null 2>&1; then
      TUI_BIN="$(command -v sumo-tui)"
    elif [ -x /run/sumo/bin/sumo-tui ]; then
      TUI_BIN="/run/sumo/bin/sumo-tui"
    elif [ -x "${ROOT}/demo/tui/sumo-tui" ]; then
      TUI_BIN="${ROOT}/demo/tui/sumo-tui"
    else
      echo "sumo dashboard: TUI binary not found (tried PATH, /run/sumo/bin/sumo-tui, ${ROOT}/demo/tui/sumo-tui)" >&2
      exit 1
    fi
    exec "$TUI_BIN" "$@"
    ;;
  refresh)
    # Re-run the live facts exporter. The NixOS module installs `sumo-facts`;
    # plain hosts use demo/host-facts.sh and get a separate live file.
    if command -v sumo-facts >/dev/null 2>&1; then
      exec sumo-facts
    elif [ -x /run/sumo/bin/sumo-facts ]; then
      exec /run/sumo/bin/sumo-facts
    elif [ -x "${ROOT}/demo/host-facts.sh" ]; then
      mkdir -p "${ROOT}/.runtime"
      "${ROOT}/demo/host-facts.sh" > "${ROOT}/.runtime/facts-live.kif"
      echo "sumo refresh: wrote ${ROOT}/.runtime/facts-live.kif (live host facts)" >&2
      echo "  read it with: SUMO_FACTS=${ROOT}/.runtime/facts-live.kif sumo status" >&2
    else
      echo "sumo refresh: no facts exporter found" >&2
      exit 1
    fi
    ;;
  guard)
    # Policy check: runs the dispatcher's guard function, exits 1 on any violation
    json_flag=""
    if [ "${1:-}" = "--json" ]; then
      json_flag="true"
      shift
    fi
    expr="($(dispatcher_args "${json_flag:-false}")).guard"
    result=$(run_nix "$expr")
    if [ "$json_flag" = "true" ]; then
      echo "$result"
      # Check if pass is false
      if echo "$result" | grep -q '"pass":false'; then
        exit 1
      fi
    else
      echo "$result"
      # Non-JSON output: check for "violation" or "Policy violation"
      if echo "$result" | grep -q "violation"; then
        exit 1
      fi
    fi
    exit 0
    ;;
  init)
    # sumo init — scaffold a new sumonix project
    init_dir="${1:-.}"
    shift || true
    
    force=false
    if [ "${1:-}" = "--force" ] || [ "${1:-}" = "-f" ]; then
      force=true
      shift
    fi
    
    mkdir -p "$init_dir"
    
    # Check for existing files
    for f in facts.kif rules.kif policies.kif .pre-commit-config.yaml .github/workflows/sumonix.yml; do
      if [ -f "$init_dir/$f" ] && [ "$force" = "false" ]; then
        echo "sumo init: $init_dir/$f already exists (use --force to overwrite)" >&2
        exit 1
      fi
    done
    
    # facts.kif template
    cat > "$init_dir/facts.kif" <<'FACTS_EOF'
;; SUMO machine facts — live facts go in the live section, fixture/scenario facts in fixture
;; Run `sumo refresh` to regenerate live facts from the system

;; source: live
;; (Live facts are auto-generated by sumo-facts. Add your own below if needed.)

;; source: fixture
;; Scenario / example facts — replace with your system's actual packages/services
;; (instance your-pkg NIXPackage)
;; (instance your-svc NIXService)
;; (serviceState your-svc running)
;; (dependsOn your-pkg some-dep)
FACTS_EOF

    # rules.kif template
    cat > "$init_dir/rules.kif" <<'RULES_EOF'
;; SUMO user rules — add custom rules here
;; The SUMO ontology + NIX domain + built-in rules are loaded automatically.
;; See rules.kif in the sumonix repo for the core transitive-dep / vulnerable / policy rules.

;; Example custom rule:
;; (=>
;;   (and
;;     (instance ?pkg NIXPackage)
;;     (license ?pkg "GPL-3.0"))
;;   (copyleft ?pkg))
RULES_EOF

    # policies.kif template
    cat > "$init_dir/policies.kif" <<'POLICIES_EOF'
;; SUMO policy goals — each (policyGoal <name> <goal-pattern>) declares a goal to check.
;; The `sumo guard` command evaluates all declared goals and reports every violation with proof.
;; source: fixture

;; Policy: No service running with a critical CVE in its transitive closure
(policyGoal NoCriticalRunningCVE (policyViolation ?pkg NoCriticalRunningCVE))

;; Policy: No package with a critical CVE should be in the closure of a running service
(policyGoal NoCriticalInServiceClosure
  (and
    (instance ?pkg NIXPackage)
    (vulnerable ?pkg ?cve)
    (severity ?cve critical)
    (instance ?svc NIXService)
    (serviceState ?svc running)
    (dependsOnTransitive ?svc ?pkg)))

;; Example: enforce that all services have a defined owner
;; (policyGoal ServiceHasOwner
;;   (and
;;     (instance ?svc NIXService)
;;     (not (runningAs ?svc ?user))))
POLICIES_EOF

    # .pre-commit-config.yaml
    mkdir -p "$init_dir/.github/workflows"
    cat > "$init_dir/.pre-commit-config.yaml" <<'PRECOMMIT_EOF'
# pre-commit hooks for SUMO policy gates
# Install: pip install pre-commit && pre-commit install
# Run manually: pre-commit run --all-files

repos:
  - repo: local
    hooks:
      - id: sumo-guard
        name: SUMO policy guard
        entry: sumo guard --json
        language: system
        types: [kif]
        # Run on facts.kif, rules.kif, policies.kif changes
        files: '\.(kif)$'
        # Requires sumo on PATH (from nix develop or nix run github:autonull/sumonix)
        pass_filenames: false
        verbose: true

      - id: sumo-lint
        name: SUMO KIF lint
        entry: sumo lint
        language: system
        types: [kif]
        files: '\.(kif)$'
        pass_filenames: true
        verbose: true
PRECOMMIT_EOF

    # CI template
    cat > "$init_dir/.github/workflows/sumonix.yml" <<'CI_EOF'
name: SUMO Policy Gate

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  sumo-guard:
    name: SUMO Policy Guard
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Nix
        uses: DeterminateSystems/nix-installer-action@v12

      - name: Run sumo guard
        # Uses the published flake: nix run github:autonull/sumonix
        # Or use the local flake if you want to test local changes:
        # run: nix run .# -- guard --json
        run: nix run github:autonull/sumonix -- guard --json
        env:
          # Point to your project's fact/rules/policies files
          SUMO_FACTS: ${{ github.workspace }}/facts.kif
          SUMO_RULES: ${{ github.workspace }}/rules.kif
          SUMO_POLICIES: ${{ github.workspace }}/policies.kif

  # Optional: run the full test suite if you depend on sumonix internals
  # tests:
  #   runs-on: ubuntu-latest
  #   steps:
  #     - uses: actions/checkout@v4
  #     - uses: DeterminateSystems/nix-installer-action@v12
  #     - run: nix flake check --all-systems
CI_EOF

    echo "sumo init: scaffolded $init_dir"
    echo ""
    echo "Created:"
    echo "  $init_dir/facts.kif       — machine facts (live + fixture sections)"
    echo "  $init_dir/rules.kif       — custom rules"
    echo "  $init_dir/policies.kif    — policy goals for sumo guard"
    echo "  $init_dir/.pre-commit-config.yaml  — pre-commit hooks"
    echo "  $init_dir/.github/workflows/sumonix.yml  — CI policy gate"
    echo ""
    echo "Next steps:"
    echo "  1. Edit facts.kif with your actual packages/services (or run 'sumo refresh' on NixOS)"
    echo "  2. Edit policies.kif with your compliance requirements"
    echo "  3. Run 'sumo guard' to check policies"
    echo "  4. Install pre-commit: pip install pre-commit && pre-commit install"
    echo "  5. Push to trigger the CI policy gate"
    ;;
  lint)
    # sumo lint — validate KIF syntax using the parser
    lint_files="${@:-}"
    if [ -z "$lint_files" ]; then
      lint_files="facts.kif rules.kif policies.kif"
    fi
    
    for f in $lint_files; do
      if [ ! -f "$f" ]; then
        echo "sumo lint: file not found: $f" >&2
        exit 1
      fi
      f_abs=$(abs_path "$f")
      echo "linting $f..."
      expr="(import ${DISPATCHER} { facts = \"$f_abs\"; rules = \"${ROOT}/rules.kif\"; }).lint \"$f_abs\""
      run_nix "$expr" || exit 1
    done
    echo "All files OK"
    ;;
  *)
    echo "sumo: unknown command '$cmd'" >&2
    echo "Run 'sumo --help' for usage." >&2
    exit 2
    ;;
esac