;; Hugging Face tags anchored in SUMO.  (hfAnchor FACET TAG HOW CLASS)
;;   exact    CLASS means the same as the tag
;;   broader  CLASS is a SUMO class the tag falls under: the tag is narrower
;;   new      SUMO has no class for it: CLASS is declared below with (subclass CLASS PARENT) and PARENT is in SUMO
;; (hfGroup FACET CLASS): every anchor of FACET must be CLASS or lie below it, so a group cannot drift off its branch.
;; (hfUnanchored FACET TAG "reason"): left out on purpose.
;; Facets left out of SUMO on purpose: size, format, library. They describe files and tools, not what a dataset is about.
;; Care: SUMO's Table is a piece of furniture and its Medicine is a drug. Neither is used here.
(hfGroup modality ContentBearingObject)
(hfGroup task Process)
(hfGroup domain FieldOfStudy)
(hfGroup origin Attribute)
(hfGroup license License)

(hfAnchor modality text exact Text)
(hfAnchor modality image exact Image)
(hfAnchor modality document exact Document)
(hfAnchor modality audio broader AudioRecording)
(hfAnchor modality video broader MotionPicture)
(hfAnchor modality tabular new TabularData)
(hfAnchor modality timeseries new TimeSeriesData)
(hfAnchor modality geospatial new GeospatialData)
(hfAnchor modality 3d new ThreeDModel)

(hfUnanchored task any-to-any "names no single process: the input and the output kinds both vary")
(hfAnchor task audio-classification broader Classifying)
(hfAnchor task audio-text-to-text broader ContentDevelopment)
(hfAnchor task audio-to-audio broader ContentDevelopment)
(hfAnchor task automatic-speech-recognition broader Interpreting)
(hfAnchor task depth-estimation broader Seeing)
(hfAnchor task document-question-answering broader Answering)
(hfAnchor task feature-extraction broader Calculating)
(hfAnchor task fill-mask broader Predicting)
(hfAnchor task graph-ml new GraphLearning)
(hfAnchor task image-classification broader Classifying)
(hfAnchor task image-feature-extraction broader Calculating)
(hfAnchor task image-segmentation broader Seeing)
(hfAnchor task image-text-to-image broader ContentDevelopment)
(hfAnchor task image-text-to-text broader ContentDevelopment)
(hfAnchor task image-text-to-video broader ContentDevelopment)
(hfAnchor task image-to-3d broader ContentDevelopment)
(hfAnchor task image-to-image broader ContentDevelopment)
(hfAnchor task image-to-text broader ContentDevelopment)
(hfAnchor task image-to-video broader ContentDevelopment)
(hfAnchor task keypoint-detection broader Seeing)
(hfAnchor task mask-generation broader Seeing)
(hfAnchor task multiple-choice broader Answering)
(hfAnchor task object-detection broader Seeing)
(hfAnchor task question-answering broader Answering)
(hfAnchor task reinforcement-learning broader Learning)
(hfAnchor task robotics new RoboticControl)
(hfAnchor task sentence-similarity broader Comparing)
(hfAnchor task summarization broader ContentDevelopment)
(hfAnchor task table-question-answering broader Answering)
(hfAnchor task table-to-text broader ContentDevelopment)
(hfAnchor task tabular-classification broader Classifying)
(hfAnchor task tabular-regression broader Predicting)
(hfAnchor task tabular-to-text broader ContentDevelopment)
(hfAnchor task text-classification broader Classifying)
(hfAnchor task text-generation broader ContentDevelopment)
(hfAnchor task text-ranking broader Searching)
(hfAnchor task text-retrieval broader Searching)
(hfAnchor task text-to-3d broader ContentDevelopment)
(hfAnchor task text-to-audio broader ContentDevelopment)
(hfAnchor task text-to-image broader ContentDevelopment)
(hfAnchor task text-to-speech broader Speaking)
(hfAnchor task text-to-video broader ContentDevelopment)
(hfAnchor task time-series-forecasting broader Predicting)
(hfAnchor task token-classification broader Classifying)
(hfAnchor task translation exact Translating)
(hfAnchor task unconditional-image-generation broader ContentDevelopment)
(hfAnchor task video-classification broader Classifying)
(hfAnchor task video-text-to-text broader ContentDevelopment)
(hfAnchor task video-to-video broader ContentDevelopment)
(hfAnchor task visual-document-retrieval broader Searching)
(hfAnchor task visual-question-answering broader Answering)
(hfAnchor task voice-activity-detection broader Hearing)
(hfAnchor task zero-shot-classification broader Classifying)
(hfAnchor task zero-shot-image-classification broader Classifying)
(hfAnchor task zero-shot-object-detection broader Seeing)

(hfAnchor domain medical exact MedicalScience)
(hfAnchor domain biology exact Biology)
(hfAnchor domain chemistry exact Chemistry)
(hfAnchor domain finance new FinanceField)
(hfAnchor domain legal new LegalField)
(hfAnchor domain climate new ClimateScience)
(hfAnchor domain art new ArtField)
(hfAnchor domain music new MusicField)
(hfAnchor domain code new ComputingField)
(hfAnchor domain agent new AgentSystemsField)
(hfUnanchored domain simready "names a profile of 3D assets for simulation, not a subject")
(hfAnchor origin synthetic new SyntheticOrigin)

;; Classes SUMO lacks, each placed under a class it has.
(subclass TabularData ContentBearingObject)
(subclass TimeSeriesData ContentBearingObject)
(subclass GeospatialData ContentBearingObject)
(subclass ThreeDModel ContentBearingObject)
(subclass RoboticControl IntentionalProcess)
(subclass GraphLearning Learning)
(subclass FinanceField FieldOfStudy)
(subclass LegalField FieldOfStudy)
(subclass ClimateScience Science)
(subclass ArtField FieldOfStudy)
(subclass MusicField FieldOfStudy)
(subclass ComputingField FieldOfStudy)
(subclass AgentSystemsField FieldOfStudy)
(subclass SyntheticOrigin Attribute)

