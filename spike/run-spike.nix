{ pkgs ? import <nixpkgs> {} }:

let
  # Path to sumo-nix source copied into VM
  sumoNixPath = "/etc/sumo-nix";

  # Load modules directly from copied source
  kif = import "${sumoNixPath}/kif.nix";
  sumo = import "${sumoNixPath}/sumo.nix" { forms = kif.parse (builtins.readFile "${sumoNixPath}/sumo.full/Merge.kif"); };
  datalog = import "${sumoNixPath}/datalog.nix" { ontology = sumo; };

  # Read facts generated by spike runner
  snapshot = builtins.readFile /run/sumo-facts.kif;

  # Rules: transitive dependency closure + capability composition
  rules = ''
    ;; SUMO-aligned: NIXPackage subclasses SoftwareArtifact (per nix-domain.kif)
    ;; dependsOn is a BinaryRelation; transitive closure via Datalog

    (=>
      (and (dependsOn ?a ?b) (dependsOn ?b ?c))
      (dependsOnTransitive ?a ?c))

    (=>
      (and (dependsOn ?a ?b) (dependsOnTransitive ?b ?c))
      (dependsOnTransitive ?a ?c))

    ;; Capability composition rules
    (=>
      (and
        (instance ?pkg NIXPackage)
        (providesCapability ?pkg ?capA)
        (composesWith ?capA ?capB)
        (providesCapability ?other ?capB)
        (dependsOn ?pkg ?other))
      (canCompose ?pkg ?capA ?capB))

    (=>
      (and (composesWith ?a ?b) (composesWith ?b ?c))
      (composesWithTransitive ?a ?c))

    (=>
      (and (composesWith ?a ?b) (composesWithTransitive ?b ?c))
      (composesWithTransitive ?a ?c))

    ;; Find novel capability combinations a package enables
    (=>
      (and
        (instance ?pkg NIXPackage)
        (providesCapability ?pkg ?cap)
        (composesWithTransitive ?cap ?otherCap)
        (providesCapability ?dep ?otherCap)
        (dependsOnTransitive ?pkg ?dep))
      (enablesCapability ?pkg ?otherCap))

    ;; Capability synergy: when 3+ capabilities combine
    (=>
      (and
        (enablesCapability ?pkg ?cap1)
        (enablesCapability ?pkg ?cap2)
        (enablesCapability ?pkg ?cap3)
        (not (= ?cap1 ?cap2))
        (not (= ?cap1 ?cap3))
        (not (= ?cap2 ?cap3)))
      (synergy ?pkg ?cap1 ?cap2 ?cap3))
  '';

  # Capability composition seed facts
  capabilities = ''
    ;; Web stack compositions
    (composesWith HTTPServer TLS)
    (composesWith HTTPServer ReverseProxy)
    (composesWith HTTPServer LoadBalancer)
    (composesWith ReverseProxy TLS)
    (composesWith LoadBalancer TLS)

    ;; Data stack compositions
    (composesWith RelationalDB ACID)
    (composesWith RelationalDB SQL)
    (composesWith KeyValueStore PubSub)
    (composesWith KeyValueStore Cache)
    (composesWith EmbeddedDB SQL)

    ;; Language runtime compositions
    (composesWith JavaScriptRuntime WebServer)
    (composesWith JavaScriptRuntime PackageManager)
    (composesWith Scripting DataScience)
    (composesWith Scripting WebFramework)
    (composesWith Scripting ML)
    (composesWith Compilation C)
    (composesWith Compilation "C++")

    ;; System compositions
    (composesWith ServiceManagement InitSystem)
    (composesWith ServiceManagement IPC)
    (composesWith ServiceManagement ServiceDiscovery)
    (composesWith SSHServer RemoteAccess)
    (composesWith SSHClient SFTP)
    (composesWith TLS Crypto)
    (composesWith X509 Crypto)

    ;; Build tool compositions
    (composesWith BuildAutomation BuildConfiguration)
    (composesWith BuildConfiguration DependencyDiscovery)
    (composesWith LibraryBuilding Compilation)

    ;; Interactive compositions
    (composesWith TUI InteractiveCLI)
    (composesWith TextEditing PatternMatching)
    (composesWith TextEditing StreamEditing)
    (composesWith TextProcessing DataExtraction)

    ;; Archive/Compression
    (composesWith ArchiveHandling Compression)
    (composesWith FileTransfer HTTPClient)
    (composesWith RecursiveDownload HTTPClient)

    ;; Version control
    (composesWith VersionControl DistributedSync)
    (composesWith DistributedSync SSHClient)
  '';

  allForms = kif.parse (snapshot + "\n" + rules + "\n" + capabilities);
  kb = datalog.facts allForms;

  # Query 1: Direct capability compositions (what can each package compose with its deps?)
  directComps = datalog.ask kb "(canCompose ?pkg ?capA ?capB)";

  # Query 2: Enabled capabilities via transitive deps
  enabledCaps = datalog.ask kb "(enablesCapability ?pkg ?cap)";

  # Query 3: Synergies (3+ capabilities)
  synergies = datalog.ask kb "(synergy ?pkg ?cap1 ?cap2 ?cap3)";

  # Format results as readable output
  formatDirect = row: "🔗 ${row.pkg} composes ${row.capA} + ${row.capB}";
  formatEnabled = row: "✨ ${row.pkg} enables ${row.cap} via transitive deps";
  formatSynergy = row: "🚀 ${row.pkg} synergy: ${row.cap1} + ${row.cap2} + ${row.cap3}";

  output = ''
    ╔═══════════════════════════════════════════════════════════════╗
    ║           SUMO-NIX CAPABILITY DISCOVERY SPIKE                 ║
    ║       "What novel capabilities can I compose?"                ║
    ╚═══════════════════════════════════════════════════════════════╝

    📦 DIRECT COMPOSITIONS (package + immediate deps):
    ${lib.concatStringsSep "\n" (lib.map formatDirect directComps)}

    🌐 ENABLED CAPABILITIES (via transitive dependency closure):
    ${lib.concatStringsSep "\n" (lib.map formatEnabled enabledCaps)}

    💡 SYNERGIES (3+ capabilities combining):
    ${lib.concatStringsSep "\n" (lib.map formatSynergy synergies)}

    ────────────────────────────────────────────────────────────────
    ✨ Spike complete. Your nixpkgs is a capability goldmine.
  '';
in
output