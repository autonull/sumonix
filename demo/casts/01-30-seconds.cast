[0.000, "o", "\u001b[1;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m│\u001b[0m A build fails. The engine knows why. The why is a file you can re-check.\r\n\u001b[1;36m│\u001b[0m \r\n"]
[0.000, "o", "\u001b[1;36m│\u001b[0m Step 1 — the reasoner finds: nginx breaks the advisory policy.\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m ./nix-eval.sh --raw --expr 'import ./tests/proof-artifact.nix' > /tmp/proof.kif\r\n"]
[0.023, "o", "\u001b[?25l"]
[0.000, "o", "\r\u001b[0m\u001b[K"]
[1.029, "o", "\r\u001b[K\u001b[?25h"]
[0.007, "o", "\u001b[1;36m│\u001b[0m wrote /tmp/proof.kif (343 lines)\r\n"]
[0.000, "o", "\u001b[1;36m│\u001b[0m \r\n"]
[0.000, "o", "\u001b[1;36m│\u001b[0m Step 2 — re-check the certificate with a checker that shares no code with the engine.\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m ./nix-eval.sh --expr '(import ./proof-check.nix { file = /tmp/proof.kif; })'\r\n"]
[0.022, "o", "\u001b[?25l"]
[0.000, "o", "\r\u001b[0m\u001b[K"]
[0.324, "o", "\r\u001b[K\"proof: 9 steps, independently re-checked ✓\"\r\n\r\u001b[0m\u001b[K"]
[0.000, "o", "\r\u001b[K\u001b[?25h"]
[0.004, "o", "\u001b[1;36m│\u001b[0m \r\n"]
[0.000, "o", "\u001b[1;36m│\u001b[0m Step 3 — alter the certified goal; the checker must refuse it.\r\n\u001b[1;32m$\u001b[0m cp /tmp/proof.kif /tmp/proof-bad.kif\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m sed -i 's/(goal (policyViolation nginx NoCriticalRunningCVE) \"s9\")/(goal (policyViolation nginx NOPE) \"s9\")/' /tmp/proof-bad.kif\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m ./nix-eval.sh --expr '(import ./proof-check.nix { file = /tmp/proof-bad.kif; })'\r\n"]
[0.348, "o", "\u001b[1;36m│\u001b[0m refused ✓  (the checker exits non-zero and says which line broke)\r\n"]
